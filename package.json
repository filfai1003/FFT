    "prettier": "^3.9.9",
    "react-test-renderer": "^19.2.3",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "check": "npm run lint && npm run typecheck && npm test && npm run db:verify",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:seed": "node supabase/scripts/generate-seed.js",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:verify": "node --import ./server/ts-resolve.mjs --test supabase/verify/db.test.mjs",
    "db:images": "node supabase/scripts/upload-images.mjs",
    "db:demo": "docker exec -i supabase_db_fft psql -U postgres -v ON_ERROR_STOP=1 -f - < supabase/scripts/demo-data.sql"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 20000
  }
}
